# 统一换行符：仓库里一律存 LF（避免 Windows 检出 CRLF 导致
# shell 脚本在 Linux/CI 上报 "bad interpreter: /usr/bin/env: bash^M"）。
* text=auto eol=lf

# 明确按文本处理的类型
*.go      text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf

# 二进制：不要做任何换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.zip     binary
*.gz      binary
*.exe     binary
