# 同绘 CoDraw · 环境变量示例
# 用法：cp .env.example .env   （.env 已在 .gitignore 中）
#
# 单实例零依赖（默认，无需 Postgres/Redis）：
#   BROKER=memory
#   STORE=memory
#
# 生产 / 多实例：
#   BROKER=redis
#   STORE=postgres
#   并确保 DATABASE_URL / REDIS_URL 指向可用服务

# ---------- 进程 ----------
# 监听端口（PRD 固定 8080）
PORT=8080
# production | development
APP_ENV=development
# 对外可访问的 origin，用于生成分享链接与 Origin 白名单
# 反代场景必须显式配置，否则按 X-Forwarded-Proto + Host 推导
PUBLIC_BASE_URL=http://localhost:8080
# 额外允许的 WS Origin，逗号分隔
ALLOWED_ORIGINS=
# 压测工具无 Origin 头时置 true；生产必须 false
ALLOW_EMPTY_ORIGIN=false

# ---------- 存储开关 ----------
# memory | postgres
STORE=memory
# memory | redis（redis 用于跨实例广播 + seq 分配）
BROKER=memory

DATABASE_URL=postgres://codraw:codraw@postgres:5432/codraw?sslmode=disable
REDIS_URL=redis://redis:6379/0
# Postgres 连接池
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ---------- 业务 ----------
# 房间空闲多久后过期（小时），720h = 30 天
ROOM_TTL=720h
# 只读 token 的 HMAC 密钥，生产必须换成 ≥32 字节随机串
# 生成：openssl rand -base64 48
READONLY_SECRET=dev-only-change-me-please-32bytes-min
# 只读 token 默认有效期（秒），86400 = 24h
READONLY_TTL=86400

# ---------- 容量与限流 ----------
MAX_CONN_PER_ROOM=200
MAX_CONN_TOTAL=5000
MAX_MESSAGE_BYTES=65536
MAX_SHAPE_BYTES=32768
MAX_SHAPES_PER_ROOM=20000
OPS_PER_SECOND=60
OPS_BURST=120
CURSOR_PER_SECOND=20
# 事件日志每房间保留条数（必须 >= resumeMaxOps）
EVENT_RETENTION=5000
# 快照间隔（每 N 条事件打一次）
SNAPSHOT_EVERY=500
# 快照保留个数
SNAPSHOT_KEEP=3

# ---------- 运维 ----------
# 设置后 /metrics 与 /ops 需要 Authorization: Bearer <token>
METRICS_TOKEN=
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 优雅停机预算（秒）
SHUTDOWN_TIMEOUT=5

# ---------- 前端（Vite 构建时注入） ----------
# 前端产物由后端同源托管时留空；本地 dev 由 vite proxy 处理
VITE_API_BASE=
VITE_WS_PATH=/ws
