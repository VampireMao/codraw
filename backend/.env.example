# CoDraw backend configuration reference.
#
# This file documents every variable the server reads. It is NOT loaded
# automatically: the server reads os.Getenv only, so containers receive these
# values from docker compose, Kubernetes or systemd. Copy the lines you need into
# your compose file or shell.
#
# Defaults are chosen so that `go run ./cmd/server` works with zero
# configuration and zero external services.

# --- Process ---------------------------------------------------------------
# development | production | test
APP_ENV=development
# json | text
LOG_FORMAT=json
# debug | info | warn | error
LOG_LEVEL=info
# Absolute origin used to build share links; required when APP_ENV=production.
# PUBLIC_BASE_URL=https://codraw.example.com

# --- HTTP ------------------------------------------------------------------
HTTP_ADDR=:8080
READ_HEADER_TIMEOUT=5s
IDLE_TIMEOUT=120s
MAX_HEADER_BYTES=65536
# How long SIGTERM waits for in-flight requests before forcing close.
SHUTDOWN_TIMEOUT=15s
# Bound for /readyz dependency pings.
DEPENDENCY_TIMEOUT=3s
# Honour X-Forwarded-For / X-Real-IP. Only enable behind a trusted proxy,
# otherwise clients can spoof their IP and bypass per-IP rate limits.
TRUST_PROXY_HEADERS=false

# --- CORS (development only) ----------------------------------------------
# Comma separated origins, or "*" (rejected when APP_ENV=production).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage and broker ----------------------------------------------------
# STORE=memory (default, zero dependencies) | postgres
STORE=memory
# DATABASE_URL=postgres://codraw:codraw@localhost:5432/codraw?sslmode=disable
STORE_CONNECT_TIMEOUT=3s

# BROKER=memory (default, single instance) | redis
BROKER=memory
# REDIS_URL=redis://localhost:6379/0
BROKER_CONNECT_TIMEOUT=3s

# Room is deleted after this long without activity.
ROOM_IDLE_TTL=168h

# --- Metrics ---------------------------------------------------------------
# When set, /metrics requires "Authorization: Bearer <token>".
# METRICS_TOKEN=

# --- Protocol limits (docs/API.md §1.1) ------------------------------------
MAX_CONN_PER_ROOM=200
MAX_CONN_TOTAL=5000
MAX_MESSAGE_BYTES=65536
MAX_SHAPE_BYTES=32768
MAX_SHAPES_PER_ROOM=20000
OPS_PER_SECOND=40
OPS_BURST=80
CURSOR_PER_SECOND=20
SNAPSHOT_CHUNK_SHAPES=500
RESUME_MAX_OPS=2000
RESUME_MAX_BYTES=4194304

# --- REST rate limiting (per IP) -------------------------------------------
API_RATE_LIMIT_RPS=20
API_RATE_LIMIT_BURST=40
# Room creation has its own, much stricter bucket (docs/API.md §1.1).
ROOM_CREATE_RATE_PER_HOUR=5
ROOM_CREATE_BURST=10
RATE_LIMIT_BUCKET_IDLE_TTL=10m
